# Temporary, hidden, symlinked, or generated files
.deleteme*
_deleteme*
.docker_volumes
# Scoped to scratch directories and temp-prefixed names rather than `temp*`,
# which also matched `template.md` — the ADR template was created, ignored, and
# left two documents pointing at a file git said did not exist.
**/hidden
**/temp/
**/temp-*
**/_temp/
**/_temp-*
temp.*
_temp.*
*.tmp
*.temp
!template*

