{
  "name": "buntap",
  "version": "0.1.0",
  "description": "Pipe bun test output through a TAP14, nyan, markdown, block, or agent reporter",
  "type": "module",
  "bin": {
    "buntap": "./dist/bin.js",
    "bunt": "./dist/bunt.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "// BUILD": "=============================BUILD=============================",
    "build": "bun build ./src/bin.ts ./src/bunt.ts --target=node --format=esm --outdir=dist && tsc -p tsconfig.build.json",
    "// LINT": "==============================LINT==============================",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "// TEST": "==============================TEST==============================",
    "test": "./bin/test",
    "test:agent": "./bin/test-agent",
    "test:markdown": "./bin/test-markdown",
    "test:verbose": "./bin/test-block --verbose --coverage",
    "test:watch": "bun test --watch",
    "// TYPECHECK": "=======================TYPECHECK===========================",
    "typecheck": "tsc --noEmit",
    "// PUBLISH": "==========================PUBLISH============================",
    "prepublish": "bun run lint && bun run typecheck && bun run test:agent && bun run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "author": "Andy Wright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/losandes/buntap.git"
  },
  "homepage": "https://github.com/losandes/buntap#readme",
  "bugs": {
    "url": "https://github.com/losandes/buntap/issues"
  },
  "keywords": [
    "bun",
    "bun-test",
    "tap",
    "tap14",
    "test-reporter",
    "nyan",
    "cli"
  ]
}
