{
  "name": "buntap",
  "version": "0.1.0",
  "description": "Pipe bun test output through a TAP14, nyan, markdown, block, or agent reporter",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": { "node": ">=22" },
  "bin": { "buntap": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "keywords": ["bun", "bun-test", "tap", "tap14", "test-reporter", "nyan", "cli"],
  "scripts": {
    "build": "bun build ./src/bin.ts --target=node --format=esm --outdir=dist && tsc -p tsconfig.build.json",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:ci": "bun test --coverage",
    "prepublishOnly": "bun run check && bun run typecheck && bun run test:coverage && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.7",
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  }
}
