  },
  `$obj.$prop >>= $val` as $stmt where {
    $obj <: not "this",
    $prop <: not or {
      "current", "displayName",
      "style", "dataset", "innerHTML", "innerText", "textContent",
      "className", "src", "href", "scrollTop", "scrollLeft",
      "width", "height", "value", "checked", "disabled", "title",
