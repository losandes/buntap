      message = "`>>=` reads a property and writes it back. Build the new value and return it rather than editing the one you were given.",
      severity = "error"
    )
  },
  `$obj.$prop >>>= $val` as $stmt where {
    $obj <: not "this",
    $prop <: not or {
      "current", "displayName",
      "style", "dataset", "innerHTML", "innerText", "textContent",
      "className", "src", "href", "scrollTop", "scrollLeft",
      "width", "height", "value", "checked", "disabled", "title",
      "locals", "statusCode",
      "length"
    },
    register_diagnostic(
      span = $stmt,
      message = "`>>>=` reads a property and writes it back. Build the new value and return it rather than editing the one you were given.",
      severity = "error"
    )
  },
  `$obj.$prop++` as $stmt where {
    $obj <: not "this",
    register_diagnostic(span = $stmt, message = "++ mutates the property in place. Compute the next value and return it.", severity = "error")
  },
  `$obj.$prop--` as $stmt where {
    $obj <: not "this",
    register_diagnostic(span = $stmt, message = "-- mutates the property in place. Compute the next value and return it.", severity = "error")
  },
  `++$obj.$prop` as $stmt where {
    $obj <: not "this",
    register_diagnostic(span = $stmt, message = "++ mutates the property in place. Compute the next value and return it.", severity = "error")
  },
  `--$obj.$prop` as $stmt where {
    $obj <: not "this",
    register_diagnostic(span = $stmt, message = "-- mutates the property in place. Compute the next value and return it.", severity = "error")
  },
  `Reflect.set($args)` as $call where {
    register_diagnostic(span = $call, message = "Reflect.set writes into an existing object; it is assignment with the syntax hidden. Build a new object with spread.", severity = "error")
  },
  `Object.defineProperty($args)` as $call where {
    register_diagnostic(span = $call, message = "defineProperty changes an object that already exists. Declare the property where the object is built.", severity = "error")
  },
  `Object.defineProperties($args)` as $call where {
    register_diagnostic(span = $call, message = "defineProperties changes an object that already exists. Declare the properties where the object is built.", severity = "error")
  },
  `Object.setPrototypeOf($args)` as $call where {
    register_diagnostic(span = $call, message = "setPrototypeOf rewrites the prototype of a live object. Use Object.create or a class at construction.", severity = "error")
  },
  `$obj.$prop = $val` as $stmt where {
    // Class-internal state. A design problem this rule cannot fix.
    $obj <: not "this",
    $prop <: not or {
      // React: a ref is the documented escape hatch, and displayName is set
      // on a component after definition because there is nowhere else.
      "current", "displayName",
      // The DOM, where assignment is the whole interface.
      "style", "dataset", "innerHTML", "innerText", "textContent",
      "className", "src", "href", "scrollTop", "scrollLeft",
      "width", "height", "value", "checked", "disabled", "title",
      // Server frameworks: the per-request channel a handler is given.
      "locals", "statusCode",
      // Node/Bun: the only way a CLI entry point reports its exit status to
      // the shell that spawned it. There is no return value this reaches.
      "exitCode",
      // Owned by the array rule, which reports it in every layer.
      "length"
    },
    register_diagnostic(
      span = $stmt,
      message = "This builds a new value rather than mutating an existing one. Return an object built with spread, or move the change into the transform that produced the value. If an external API requires assignment, that call belongs in the adapter that owns it.",
      severity = "error"
    )
  },
  `Object.assign($target, $rest)` as $call where {
    // Assigning onto a fresh literal is construction, not mutation.
    $target <: not `{ $_ }`,
    register_diagnostic(
      span = $call,
      message = "Object.assign writes into its first argument. Build a new object with spread, or pass a fresh literal as the target.",
      severity = "error"
    )
  }
}
